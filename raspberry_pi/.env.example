# .env.example — copy to .env and fill in your values

# Firebase configuration
FIREBASE_CREDENTIALS_PATH=/home/pi/cryingsense/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Device identity (leave empty to auto-detect from MAC address)
DEVICE_ID=

# Model path override (auto-detected from saved_models/ by default)
# MODEL_PATH=/home/pi/cryingsense/raspberry_pi/saved_models/cryingsense_model.onnx

# Network — Android app endpoints
APP_API_HOST=0.0.0.0
APP_API_PORT=8765

# Audio
# MIC_DEVICE_INDEX=0
# SAMPLE_RATE=16000
# DURATION=5.0

# Pipeline
# PREDICTION_INTERVAL=5.0
# CONFIDENCE_THRESHOLD=0.70
# NOISE_REDUCE=true

# Logging
# LOG_LEVEL=INFO
