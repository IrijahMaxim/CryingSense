# CryingSense Database Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================
# MongoDB Atlas (Cloud) - RECOMMENDED
# ============================================
# Get your connection string from MongoDB Atlas Dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>
# MONGO_URI=mongodb+srv://admin:adminpassword123@cryingsense.qpdshid.mongodb.net/cryingsense_db

# ============================================
# MongoDB Local (Development)
# ============================================
# MONGO_HOST=admin
# MONGO_PORT=adminpassword123

# Database name
MONGO_DATABASE=cryingsense_db

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Timeout Settings (milliseconds)
MONGO_CONNECTION_TIMEOUT=5000
MONGO_SERVER_SELECTION_TIMEOUT=5000
