# CryingSense Database Environment Configuration
# Copy this file to .env and configure for your environment

# MongoDB Atlas Connection
# Use connection string format for Atlas clusters
MONGO_URI=mongodb+srv://admin:adminpassword123@cryingsense.qpdshid.mongodb.net/cryingsense_db
MONGO_DATABASE=cryingsense_db

# Replace <username> and <password> with your Atlas credentials
MONGO_USERNAME=admin
MONGO_PASSWORD=adminpassword123

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Timeout Settings (milliseconds)
MONGO_CONNECTION_TIMEOUT=5000
MONGO_SERVER_SELECTION_TIMEOUT=5000
